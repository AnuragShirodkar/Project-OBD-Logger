{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkiDrive standard Teensy firmware package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "package_kind", "product", "device_type", "firmware_version", "target", "payload", "release_notes", "signing"],
  "properties": {
    "format": {"const": "skidrive-firmware-package"},
    "format_version": {"type": "integer", "const": 1},
    "package_kind": {"enum": ["integration-template", "release"]},
    "product": {"const": "SkiDrive"},
    "device_type": {"const": "OBD_LOGGER"},
    "firmware_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["board", "mcu", "hardware_revisions", "usb_update_protocol"],
      "properties": {
        "board": {"const": "teensy41-standard"},
        "mcu": {"const": "IMXRT1062"},
        "hardware_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,32}$"}},
        "usb_update_protocol": {"type": "integer", "const": 1}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "format", "size_bytes", "sha256"],
      "properties": {
        "file": {"const": "firmware.hex"},
        "format": {"const": "intel-hex"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "release_notes": {"const": "release-notes.txt"},
    "signing": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["algorithm", "key_id", "file"],
          "properties": {
            "algorithm": {"const": "Ed25519"},
            "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
            "file": {"const": "signature.ed25519"}
          }
        }
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"package_kind": {"const": "integration-template"}}},
      "then": {"properties": {"signing": {"type": "null"}}}},
    {"if": {"properties": {"package_kind": {"const": "release"}}},
      "then": {"properties": {
        "signing": {"type": "object"},
        "target": {"properties": {"hardware_revisions": {"items": {"not": {"const": "unassigned"}}}}}
      }}}
  ]
}
